{
  "name": "semion-vite-react-example",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pipeline": "pnpm --filter semion build && node scripts/prepare-pipeline.mjs",
    "dev": "pnpm run prepare:pipeline && vite --host 127.0.0.1",
    "build": "pnpm run prepare:pipeline && vite build",
    "typecheck": "pnpm run prepare:pipeline && tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semion": "workspace:*"
  },
  "devDependencies": {
    "@ferriki/core": "1.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
