{
  "name": "semion",
  "version": "0.0.1",
  "description": "Compile-time SVG mask icons for React and Vite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/semion.git"
  },
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "keywords": [
    "svg",
    "icons",
    "react",
    "vite",
    "vite-plugin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@types/react": ">=18 <20",
    "react": ">=18",
    "vite": ">=8"
  },
  "dependencies": {
    "magic-string": "^0.30.21",
    "oxc-parser": "0.141.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.4",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
